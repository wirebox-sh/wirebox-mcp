{
  "name": "@wirebox-sh/mcp",
  "version": "0.1.0",
  "description": "Official Model Context Protocol (MCP) server for Wirebox — Real-world identity and communication layer for AI agents",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "wirebox-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wirebox",
    "mcp",
    "modelcontextprotocol",
    "agent",
    "ai",
    "imessage",
    "email",
    "identity"
  ],
  "homepage": "https://wirebox.sh",
  "repository": {
    "type": "git",
    "url": "https://github.com/wirebox-sh/wirebox-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/wirebox-sh/wirebox-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@wirebox-sh/sdk": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
